local activeTab = nil

local function setActiveTab(name)
    if not name or not tabButtons[name] then return end
    activeTab = name
    for t, btn in pairs(tabButtons) do
        local on = (t == name)
        TweenService:Create(btn.frame, TweenInfo.new(0.15), {
            BackgroundColor3 = on and Color3.fromRGB(60, 60, 60) or Color3.fromRGB(0, 0, 0),
            BackgroundTransparency = on and 0.55 or 0.85,
        }):Play()
        TweenService:Create(btn.label, TweenInfo.new(0.15), {
            TextColor3 = on and THEME.Text or THEME.TextSecondary,
        }):Play()
    end
    for tabName, page in pairs(tabPages) do
        page.Visible = (tabName == name)
    end
end

