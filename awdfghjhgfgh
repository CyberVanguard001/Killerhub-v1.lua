local function makeToggleRow(parentBody, order, title, subtitle, default, onChange)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, subtitle and 36 or 26),
        BackgroundTransparency = 1,
        LayoutOrder = order,
        ZIndex = 15,
        Parent = parentBody,
    })
    make("TextLabel", {
        Size = UDim2.new(1, -50, 0, 14),
        Position = UDim2.fromOffset(0, subtitle and 4 or 6),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 10,
        TextColor3 = THEME.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = title,
        ZIndex = 16,
        Parent = row,
    })
    if subtitle then
        make("TextLabel", {
            Size = UDim2.new(1, -50, 0, 10),
            Position = UDim2.fromOffset(0, 20),
            BackgroundTransparency = 1,
            Font = Enum.Font.Gotham,
            TextSize = 8,
            TextColor3 = THEME.TextMuted,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = subtitle,
            ZIndex = 16,
            Parent = row,
        })
    end
    local pill = make("TextButton", {
        Size = UDim2.fromOffset(32, 16),
        Position = UDim2.new(1, -32, 0, subtitle and 10 or 5),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = default and 0.3 or 0.7,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 16,
        Parent = row,
    })
    corner(pill, 8)
    addStroke(pill, 1, 0.25)
    local dot = make("Frame", {
        Size = UDim2.fromOffset(10, 10),
        Position = default and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 17,
        Parent = pill,
    })
    corner(dot, 5)
    local on = default
    local function refresh()
        TweenService:Create(pill, TweenInfo.new(0.2), {
            BackgroundTransparency = on and 0.3 or 0.7,
        }):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {
            Position = on and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5),
        }):Play()
    end
    pill.MouseButton1Click:Connect(function()
        on = not on
        refresh()
        if onChange then pcall(onChange, on) end
    end)
    refresh()
    return {
        Row = row,
        Get = function() return on end,
        Set = function(v)
            v = v and true or false
            if v ~= on then
                on = v
                refresh()
                if onChange then pcall(onChange, on) end
            end
        end,
    }
end

