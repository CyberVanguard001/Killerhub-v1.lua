local treadmill = {
    Enabled = false, Alive = true, Flying = false, Training = false,
    BeltOn = false, Conns = {}, Spot = nil, Holding = false,
}
local function tmWatch(signal, fn)
    local c = signal:Connect(function(...)
        if treadmill.Alive and treadmill.Enabled then fn(...) end
    end)
    table.insert(treadmill.Conns, c)
    return c
end
local function tmCleanup()
    for _, c in ipairs(treadmill.Conns) do pcall(function() c:Disconnect() end) end
    table.clear(treadmill.Conns)
end
local function tmMySlot()
    local PlotState = safeRequire(function() return ReplicatedStorage.Client.PlotState end)
    if PlotState and type(PlotState.ResolveLocalSlot) == "function" then
        local ok, s = pcall(PlotState.ResolveLocalSlot)
        if ok and type(s) == "number" then return s end
    end
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in ipairs(plots:GetChildren()) do
        local sign = p:FindFirstChild("PlotSign")
        sign = sign and sign:FindFirstChild("PlayerPlotSign")
        local f = sign and sign:FindFirstChild("Frame")
        local n = f and f:FindFirstChild("PlayerName")
        if n and n:IsA("TextLabel") and (n.Text == localPlayer.DisplayName or n.Text == localPlayer.Name) then
            return tonumber(p.Name)
        end
    end
    return nil
end
local function tmTreadmillSpot(slot)
    local renders = workspace:FindFirstChild("__ClientTreadmillRenders")
    local tr = renders and renders:FindFirstChild("TreadmillRender_" .. tostring(slot))
    if tr then
        local r = tr:FindFirstChild("Root", true)
        if r and r:IsA("BasePart") then return r.Position end
    end
    local plot = workspace:FindFirstChild("Plots") and workspace.Plots:FindFirstChild(tostring(slot))
    local b = plot and plot:FindFirstChild("TreadmillBottom")
    if b and b:IsA("BasePart") then
        return Vector3.new(b.Position.X, b.Position.Y + 4, b.Position.Z - 2)
    end
    return nil
end
local function tmTeleportBack(spotPos)
    local ch = localPlayer.Character
    if not ch then return end
    local h = ch:FindFirstChildOfClass("Humanoid")
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not h or not hrp then return end
    local dir
    if spotPos then
        dir = hrp.Position - spotPos
        if dir.Magnitude < 1 then dir = Vector3.new(1, 0, 1) end
        dir = dir.Unit
    else
        dir = Vector3.new(1, 0, 1).Unit
    end
    local dest = hrp.Position + dir * 20
    dest = Vector3.new(dest.X, hrp.Position.Y + 2, dest.Z)
    pcall(function() h.Jump = true end)
    task.wait(0.15)
    pcall(function() ch:PivotTo(CFrame.new(dest)) end)
    task.wait(0.05)
    if hrp and hrp.Parent then
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end
local function tmStopAll(msg, spotPos)
    treadmill.Flying = false
    treadmill.Training = false
    treadmill.Holding = false
    local r = root()
    local h = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if r then
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    if h then
        pcall(function()
            h:Move(Vector3.zero, false)
            h.JumpHeight = 7.2
        end)
    end
    if spotPos then task.spawn(function() tmTeleportBack(spotPos) end) end
    if msg then status(msg) end
end
local function tmGo()
    if not treadmill.Enabled then return end
    if treadmill.Training or treadmill.Flying then return end
    local slot = tmMySlot()
    if not slot then status("Auto-Treadmill: plot nao achado") return end
    local spot = tmTreadmillSpot(slot)
    if not spot then status("Auto-Treadmill: treadmill nao achada") return end
    treadmill.Spot = spot
    local ch = localPlayer.Character
    local hrp = root()
    if ch and hrp then
        pcall(function()
            ch:PivotTo(CFrame.new(spot))
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
        local h = ch:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() h:Move(Vector3.zero, false) end) end
    end
    task.wait(0.25)
    status("Auto-Treadmill: aguardando belt...")
    local t1 = os.clock()
    while treadmill.Alive and treadmill.Enabled and not treadmill.BeltOn and os.clock() - t1 < 8 do
        local r, h = root(), localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
        if r and h then
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
                h:Move(Vector3.zero, false)
            end)
        end
        RunService.Heartbeat:Wait()
    end
    if treadmill.BeltOn then return end
    local okW, res = pcall(function()
        local Remotes = require(ReplicatedStorage.Shared.Remotes)
        return Remotes.Treadmill.AskWearStill:InvokeServer()
    end)
    if okW and res == true then
        status("Auto-Treadmill: treinando!")
        treadmill.Training = true
        treadmill.Holding = true
    else
        tmStopAll("Auto-Treadmill: belt negada: " .. tostring(res), spot)
    end
end
local function tmEnable()
    if treadmill.Enabled then return end
    treadmill.Enabled = true
    treadmill.Alive = true
    treadmill.Holding = false
    pcall(function()
        local Remotes = require(ReplicatedStorage.Shared.Remotes)
        tmWatch(Remotes.Treadmill.AssignedBeltShifted.OnClientEvent, function(id)
            treadmill.BeltOn = id ~= nil
            if treadmill.BeltOn then
                treadmill.Training = true
                treadmill.Flying = false
                treadmill.Holding = true
                local h = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
                if h then pcall(function() h.JumpHeight = 0 end) end
            else
                treadmill.Training = false
                treadmill.Holding = false
                local h = localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid")
                if h then pcall(function() h.JumpHeight = 7.2 end) end
            end
        end)
    end)
    status("Auto-Treadmill: ATIVADO")
    task.spawn(function()
        task.wait(0.5)
        if not treadmill.Enabled then return end
        tmGo()
        while treadmill.Enabled and treadmill.Alive do
            task.wait(1.0)
            if not treadmill.Enabled then break end
            if treadmill.Training and treadmill.Spot then
                local hrp = root()
                if hrp and (hrp.Position - treadmill.Spot).Magnitude > 6 then
                    local ch = localPlayer.Character
                    if ch then
                        pcall(function()
                            ch:PivotTo(CFrame.new(treadmill.Spot))
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                end
            end
        end
    end)
end
local function tmDisable()
    treadmill.Enabled = false
    treadmill.Holding = false
    local spot = treadmill.Spot
    if not spot then
        local slot = tmMySlot()
        spot = slot and tmTreadmillSpot(slot)
    end
    tmStopAll("Auto-Treadmill: DESATIVADO", spot)
    tmCleanup()
    treadmill.Spot = nil
end
local stayEnable = function() tmEnable() end
local stayDisable = function() tmDisable() end

