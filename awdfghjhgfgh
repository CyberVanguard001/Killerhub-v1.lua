function predRefresh()
    if not predictorView.Visible then return end
    for _, c in ipairs(predCards) do
        if c then pcall(function() c:Destroy() end) end
    end
    predCards = {}
    local list = predListEggs()
    local counts = { all = #list, ready = 0, growing = 0, bag = 0 }
    for _, e in ipairs(list) do
        if e.Status == "Ready" then counts.ready += 1
        elseif e.Status == "Growing" then counts.growing += 1
        else counts.bag += 1 end
    end
    predBtnAll.Text = "ALL " .. counts.all
    predBtnReady.Text = "READY " .. counts.ready
    predBtnGrowing.Text = "GROWING " .. counts.growing
    predBtnBag.Text = "IN BAG " .. counts.bag
    predSetBtnState(predBtnAll, predCurrentFilter == "ALL")
    predSetBtnState(predBtnReady, predCurrentFilter == "READY")
    predSetBtnState(predBtnGrowing, predCurrentFilter == "GROWING")
    predSetBtnState(predBtnBag, predCurrentFilter == "BAG")
    local filtered = {}
    for _, e in ipairs(list) do
        local keep = false
        if predCurrentFilter == "ALL" then keep = true
        elseif predCurrentFilter == "READY" and e.Status == "Ready" then keep = true
        elseif predCurrentFilter == "GROWING" and e.Status == "Growing" then keep = true
        elseif predCurrentFilter == "BAG" and e.Status == "Inventory" then keep = true end
        if keep then filtered[#filtered+1] = e end
    end
    if predCurrentSort == "Valor" then
        table.sort(filtered, function(a, b) return a.Income > b.Income end)
    elseif predCurrentSort == "Raridade" then
        table.sort(filtered, function(a, b)
            if a.Info.RarityNumber ~= b.Info.RarityNumber then
                return a.Info.RarityNumber > b.Info.RarityNumber
            end
            return a.Income > b.Income
        end)
    elseif predCurrentSort == "Tempo Restante" then
        table.sort(filtered, function(a, b) return a.Remain < b.Remain end)
    elseif predCurrentSort == "Peso" then
        table.sort(filtered, function(a, b) return a.Weight > b.Weight end)
    end
    if #filtered == 0 then
        predStatusLabel.Text = "Nenhum ovo aqui"
        return
    end
    for i, egg in ipairs(filtered) do
        predCards[#predCards+1] = predMakeCard(egg, i)
    end
    predStatusLabel.Text = string.format("%d showing | %d total", #filtered, #list)
end
