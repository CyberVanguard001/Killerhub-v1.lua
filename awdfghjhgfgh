-- ================= RARITY FILTER =================
local RARITY_LIST = { "COMMON", "UNCOMMON", "RARE", "EPIC", "LEGENDARY", "MYTHIC", "COSMIC", "SECRET", "ETERNAL", "DIVINE" }
local rarityFilter = {}
for _, r in ipairs(RARITY_LIST) do rarityFilter[r:lower()] = false end
local function rarityAllowed(rarityName)
    if not rarityName then return false end
    local key = tostring(rarityName):lower():gsub("%s+", "")
    local anyMarked = false
    for _, v in pairs(rarityFilter) do if v then anyMarked = true break end end
    if not anyMarked then return true end
    for k, v in pairs(rarityFilter) do
        if v then
            local nk = tostring(k):lower():gsub("%s+", "")
            if nk == key then return true end
        end
    end
    return false
end
local function captureRarityFilter()
    local t = {}
    for k, v in pairs(rarityFilter) do if v then t[k] = true end end
    return t
end
local function applyRarityFilter(t)
    for k in pairs(rarityFilter) do rarityFilter[k] = false end
    if type(t) == "table" then
        for k, v in pairs(t) do
            if v == true and rarityFilter[k] ~= nil then rarityFilter[k] = true end
        end
    end
end

-- ================= AUTO LOOP =================
local autoLoop = { Active = false, Thread = nil, EsperaMax = 40, MonitorInterval = 1.5 }
local function autoPickBestUid()
    local infos = {}
    local totalEggs = 0
    for _, record in ipairs(snapshot()) do
        totalEggs += 1
        local info = describe(record)
        if info.Uid and info.Value > 0 and rarityAllowed(info.RarityName) then
            infos[#infos + 1] = info
        end
    end
    table.sort(infos, function(a, b) return a.Value > b.Value end)
    if totalEggs > 0 then
        local best = infos[1]
        if best then
            status(string.format("AUTO: %d/%d ovos ok, melhor: %s", #infos, totalEggs, best.RarityName))
        else
            status(string.format("AUTO: 0/%d ovos ok (filtro)", totalEggs))
        end
    end
    return infos[1] and infos[1].Uid or nil
end
local function autoLoopEnable()
    if autoLoop.Active then return end
    autoLoop.Active = true
    state.Cancel = false
    autoLoop.Thread = task.spawn(function()
        status("AUTO: iniciado")
        while autoLoop.Active do
            while autoLoop.Active do
                if not autoLoop.Active then break end
                local tWait = os.clock()
                while state.Busy and os.clock() - tWait < 10 do task.wait(0.2) end
                local uid = autoPickBestUid()
                if not uid then break end
                status("AUTO: pegando ovo")
                state.Cancel = false
                stealAndDeliver(uid)
                local t0 = os.clock()
                while state.Busy and autoLoop.Active and os.clock() - t0 < 180 do task.wait(0.5) end
                task.wait(0.8)
            end
            if not autoLoop.Active then break end
            status("AUTO: sem ovos, ativando treadmill")
            if not treadmill.Enabled then tmEnable() end
            if not treadmill.Holding then
                local tStart = os.clock()
                while autoLoop.Active and not treadmill.Holding and os.clock() - tStart < autoLoop.EsperaMax do
                    if not treadmill.Enabled then tmEnable() end
                    task.wait(1)
                end
            end
            if not autoLoop.Active then break end
            if not treadmill.Holding then
                status("AUTO: treadmill nao engatou, retry")
                task.wait(3)
            else
                status("AUTO: treinando, monitorando ovos")
                local foundNew = false
                while autoLoop.Active and treadmill.Holding do
                    task.wait(autoLoop.MonitorInterval)
                    if not autoLoop.Active then break end
                    if not treadmill.Holding then break end
                    local uid = autoPickBestUid()
                    if uid then foundNew = true break end
                end
                if not autoLoop.Active then break end
                if foundNew then
                    status("AUTO: novo ovo detectado, saindo da esteira")
                    if treadmill.Enabled then tmDisable() end
                    task.wait(1.5)
                else
                    task.wait(1)
                end
            end
        end
        status("AUTO: parado")
    end)
end
local function autoLoopDisable()
    if not autoLoop.Active then return end
    autoLoop.Active = false
    state.Cancel = true
    state.Paused = false
    if autoLoop.Thread then pcall(task.cancel, autoLoop.Thread) autoLoop.Thread = nil end
    if treadmill.Enabled then tmDisable() end
    task.spawn(function()
        local t0 = os.clock()
        while state.Busy and os.clock() - t0 < 5 do task.wait(0.1) end
        state.Cancel = false
    end)
    status("AUTO: DESATIVADO")
end

-- ================= PREDICTOR =================
local PRED_UNITS = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
local function predFmtRate(n)
    n = tonumber(n) or 0
    for _, u in ipairs(PRED_UNITS) do
        if n >= u[1] then
            local v = n / u[1]
            local txt = (v < 10) and string.format("%.2f", v) or string.format("%.1f", v)
            return "$" .. (txt:gsub("%.?0+$", "")) .. u[2] .. "/s"
        end
    end
    return "$" .. tostring(math.floor(n)) .. "/s"
end
local function predFmtWeight(n)
    n = tonumber(n) or 0
    if n >= 1e6 then return string.format("%.2fM Kg", n / 1e6) end
    if n >= 1e3 then return string.format("%.2fk Kg", n / 1e3) end
    if n >= 100 then return string.format("%.0f Kg", n) end
    return string.format("%.2f Kg", n)
end
local function predFmtClock(sec)
    sec = math.max(0, math.floor(tonumber(sec) or 0))
    local h = math.floor(sec / 3600)
    local m = math.floor(sec / 60) % 60
    local s = sec % 60
    if h > 0 then return string.format("%dh %02dm", h, m) end
    if m > 0 then return string.format("%dm %02ds", m, s) end
    return string.format("%ds", s)
end
local predAssetCache = {}
local function predGetAssetInfo(cat)
    cat = tostring(cat or "")
    if predAssetCache[cat] then return predAssetCache[cat] end
    local dir = Assets and Assets.Directory
    local entry = type(dir) == "table" and dir[cat] or nil
    local info = {
        Name = cat, Icon = "", EggIcon = "",
        RarityName = "Common",
        RarityColor = Color3.fromRGB(180, 180, 180),
        RarityNumber = 0, EarningRate = 0,
    }
    if type(entry) == "table" then
        info.Name = tostring(entry.DisplayName or cat)
        local icon = entry.Icon
        if icon ~= nil and tostring(icon) ~= "" then
            icon = tostring(icon)
            info.Icon = tonumber(icon) and ("rbxassetid://" .. icon) or icon
        end
        if type(entry.Egg) == "table" and entry.Egg.Icon ~= nil then
            local eicon = tostring(entry.Egg.Icon)
            info.EggIcon = tonumber(eicon) and ("rbxassetid://" .. eicon) or eicon
        end
        if type(entry.Rarity) == "table" then
            info.RarityName = tostring(entry.Rarity.DisplayName or entry.Rarity._id or "Common")
            if typeof(entry.Rarity.Color) == "Color3" then info.RarityColor = entry.Rarity.Color end
            info.RarityNumber = tonumber(entry.Rarity.RarityNumber or entry.Rarity.Rank) or 0
        end
        info.EarningRate = tonumber(entry.EarningRate) or 0
    end
    predAssetCache[cat] = info
    return info
end
local function predCalcIncome(cat, scale, mutations)
    local info = predGetAssetInfo(cat)
    scale = tonumber(scale) or 1
    if scale <= 0 then return 0 end
    local factor = scale > 5 and (scale / 5) ^ 1.2 * 19.637875755794113 or scale ^ 1.85
    local mult = 1
    if type(Mutations) == "table" and type(Mutations.EarningsFor) == "function" then
        local ok2, res = pcall(Mutations.EarningsFor, type(mutations) == "table" and mutations or {})
        if ok2 and type(res) == "number" then mult = res end
    end
    return info.EarningRate * factor * mult
end
local function predCalcWeight(cat, scale)
    if type(EggRecords) ~= "table" then return 0 end
    if type(EggRecords.WeightKgForScale) ~= "function" then return 0 end
    local ok2, res = pcall(EggRecords.WeightKgForScale, cat, tonumber(scale) or 1)
    return (ok2 and tonumber(res)) or 0
end
local function predCalcGrowth(cat, record)
    if type(EggRecords) ~= "table" then return math.huge end
    local mult = 1
    if type(EggRecords.GrowthSpeedMultiplier) == "function" then
        local ok2, res = pcall(EggRecords.GrowthSpeedMultiplier, record)
        if ok2 and tonumber(res) then mult = tonumber(res) end
    end
    local remain = math.huge
    if type(EggRecords.GrowthSecondsRemaining) == "function" then
        local ok2, res = pcall(EggRecords.GrowthSecondsRemaining, record, workspace:GetServerTimeNow(), mult)
        if ok2 and tonumber(res) then remain = tonumber(res) end
    end
    local total = 0
    if type(EggRecords.GrowthDuration) == "function" then
        local ok2, res = pcall(EggRecords.GrowthDuration, cat)
        if ok2 and tonumber(res) then total = tonumber(res) end
    end
    return remain, total
end
local function predListEggs()
    if type(EggState) ~= "table" then return {} end
    if type(EggState.ReadOwnerEggs) ~= "function" then return {} end
    local ok2, result = pcall(EggState.ReadOwnerEggs, localPlayer.UserId)
    if not ok2 or type(result) ~= "table" then return {} end
    local out = {}
    for uid, rec in pairs(result) do
        if type(rec) == "table" then
            local cat = tostring(rec.AssetCategory or "?")
            local info = predGetAssetInfo(cat)
            local scale = tonumber(rec.AssetScale) or 1
            local muts = type(rec.Mutations) == "table" and rec.Mutations or {}
            local st, remain, percent = "Inventory", math.huge, 0
            if rec.Placement ~= nil then
                local ready = false
                if type(EggState.IsReadyToHatch) == "function" then
                    local ok3, res3 = pcall(EggState.IsReadyToHatch, uid)
                    if ok3 and res3 == true then ready = true end
                end
                if ready then
                    st, remain, percent = "Ready", 0, 100
                else
                    local r2, total = predCalcGrowth(cat, rec)
                    remain = r2
                    st = "Growing"
                    if total and total > 0 then
                        percent = math.clamp(math.floor((1 - remain / total) * 100), 0, 100)
                    end
                end
            end
            out[#out+1] = {
                Uid = tostring(uid), Category = cat, Info = info,
                Scale = scale, Mutations = muts,
                Income = predCalcIncome(cat, scale, muts),
                Weight = predCalcWeight(cat, scale),
                Status = st, Remain = remain, Percent = percent,
            }
        end
    end
    return out
end

