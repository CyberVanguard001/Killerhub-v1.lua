local function ensureEsp(key, position, opts)
    if not position then
        local old = espPool[key]
        if old and old.bb then old.bb.Enabled = false end
        return
    end
    local slot = espPool[key]
    if slot and slot.bb and slot.bb.Parent then
        if slot.dummy then
            pcall(function() slot.dummy.CFrame = CFrame.new(position) end)
        end
    else
        if slot and slot.dummy then pcall(function() slot.dummy:Destroy() end) end
        slot = buildEspBillboard()
        slot.dummy = make("Part", {
            Name = "PHZEspAdorn",
            Anchored = true,
            CanCollide = false,
            CanQuery = false,
            CanTouch = false,
            CastShadow = false,
            Transparency = 1,
            Size = Vector3.new(0.15, 0.15, 0.15),
            Parent = getEspFolder(),
        })
        espPool[key] = slot
    end
    pcall(function() slot.dummy.CFrame = CFrame.new(position) end)
    slot.bb.Adornee = slot.dummy
    slot.bb.Enabled = true
    local color = opts.color or Color3.fromRGB(220, 220, 220)
    slot.title.Text = tostring(opts.name or "")
    slot.sub.Text = tostring(opts.sub or "")
    slot.accent.BackgroundColor3 = color
    slot.stroke.Color = color
    slot.stroke.Transparency = 0.25
    if opts.icon and opts.icon ~= "" then
        slot.icon.Image = opts.icon
        slot.icon.Visible = true
        slot.title.Position = UDim2.fromOffset(38, 3)
        slot.title.Size = UDim2.new(1, -44, 0, 14)
        slot.sub.Position = UDim2.fromOffset(38, 17)
        slot.sub.Size = UDim2.new(1, -44, 0, 16)
        slot.bb.Size = UDim2.fromOffset(190, opts.tall and 50 or 36)
    else
        slot.icon.Image = ""
        slot.icon.Visible = false
        slot.title.Position = UDim2.fromOffset(9, 3)
        slot.title.Size = UDim2.new(1, -14, 0, 14)
        slot.sub.Position = UDim2.fromOffset(9, 17)
        slot.sub.Size = UDim2.new(1, -14, 0, 16)
        slot.bb.Size = UDim2.fromOffset(170, opts.tall and 50 or 36)
    end
    slot.sub.TextWrapped = opts.tall == true
end

