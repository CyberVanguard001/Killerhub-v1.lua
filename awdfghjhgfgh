local function espTick()
    local D = SettingsStore.Data
    if not D.EggESP and not D.PlotESP then
        for _, slot in pairs(espPool) do
            if slot.bb then slot.bb.Enabled = false end
        end
        return
    end

    if D.EggESP then
        local seen = {}
        for _, record in ipairs(snapshot()) do
            pcall(function()
                local info = describe(record)
                local pos = record.BottomCFrame and record.BottomCFrame.Position
                if pos and info.Uid then
                    local key = "e:" .. info.Uid
                    seen[key] = true
                    ensureEsp(key, pos, {
                        name = info.Name,
                        sub = "$" .. money(info.Value) .. "/s · " .. info.RarityName,
                        color = espRarityColor(info.RarityName),
                        icon = info.Icon,
                    })
                end
            end)
        end
        for k, slot in pairs(espPool) do
            if string.sub(k, 1, 2) == "e:" and not seen[k] then
                if slot.bb then slot.bb.Enabled = false end
            end
        end
    else
        for k, slot in pairs(espPool) do
            if string.sub(k, 1, 2) == "e:" then
                if slot.bb then slot.bb.Enabled = false end
            end
        end
    end

    if D.PlotESP then
        if type(EggState) == "table" and type(EggState.ReadOwnerEggs) == "function" then
            local ok, recs = pcall(EggState.ReadOwnerEggs, localPlayer.UserId)
            if ok and type(recs) == "table" then
                local baseCF = CFrame.new()
                local plotInfo = nil
                pcall(function()
                    local PlotState = require(ReplicatedStorage.Client.PlotState)
                    if type(PlotState.ResolvePlot) == "function" then
                        plotInfo = PlotState.ResolvePlot()
                    end
                end)
                if type(plotInfo) == "table" then
                    if plotInfo.CenterPoint and plotInfo.CenterPoint:IsA("BasePart") then
                        baseCF = plotInfo.CenterPoint.CFrame
                    elseif plotInfo.PlotFolder then
                        pcall(function() baseCF = plotInfo.PlotFolder:GetPivot() end)
                    end
                end
                local seen = {}
                for uid, rec in pairs(recs) do
                    pcall(function()
                        if type(rec) == "table" and rec.Placement ~= nil then
                            local pos = nil
                            if type(rec.Placement) == "table" and rec.Placement.LocalCFrame then
                                local ok2, cf = pcall(function() return baseCF * rec.Placement.LocalCFrame end)
                                if ok2 and cf then
                                    pos = cf.Position + Vector3.new(0, 3, 0)
                                end
                            end
                            if pos then
                                local cat = tostring(rec.AssetCategory or "?")
                                local info = predGetAssetInfo(cat)
                                local ready = false
                                if type(EggState.IsReadyToHatch) == "function" then
                                    local ok3, r3 = pcall(EggState.IsReadyToHatch, uid)
                                    if ok3 and r3 == true then ready = true end
                                end
                                local sub
                                if ready then
                                    sub = predFmtRate(predCalcIncome(cat, tonumber(rec.AssetScale) or 1, rec.Mutations or {})) .. " · READY"
                                else
                                    local rem = predCalcGrowth(cat, rec)
                                    sub = predFmtRate(predCalcIncome(cat, tonumber(rec.AssetScale) or 1, rec.Mutations or {})) .. " · " .. predFmtClock(rem)
                                end
                                local key = "p:" .. tostring(uid)
                                seen[key] = true
                                ensureEsp(key, pos, {
                                    name = info.Name,
                                    sub = sub,
                                    color = ready and Color3.fromRGB(80, 255, 140) or Color3.fromRGB(220, 220, 220),
                                    icon = info.Icon,
                                    tall = true,
                                })
                            end
                        end
                    end)
                end
                for k, slot in pairs(espPool) do
                    if string.sub(k, 1, 2) == "p:" and not seen[k] then
                        if slot.bb then slot.bb.Enabled = false end
                    end
                end
            end
        end
    else
        for k, slot in pairs(espPool) do
            if string.sub(k, 1, 2) == "p:" then
                if slot.bb then slot.bb.Enabled = false end
            end
        end
    end
end

