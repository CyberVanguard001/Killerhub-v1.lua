local preservar = {
    "killerhubv1", "killerhub", "killer", "delta", "executor", "fluxus", 
    "arceus", "codex", "roblox", "chat", "core", "prompt", "interact", 
    "hold", "press", "action", "hud", "inventory", "item", "pickup",
