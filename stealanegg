-- ==================== EXECUTAR 1 VEZ ====================
local executando = false

local function executarUmaVez()
    if executando then return end
    executando = true
    
    task.spawn(function()
        local inicio = tick()
        
        for i, ev in ipairs(gravacao) do
            local char = player.Character
            if not char then break end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then break end
            
            -- Espera o tempo exato da gravação
            local decorrido = tick() - inicio
            local espera = ev.tempo - decorrido
            if espera > 0 then
                task.wait(espera)
            end
            
            -- Aplica o CFrame
            hrp.CFrame = CFrame.new(ev.x, ev.y, ev.z)
        end
        
        executando = false
    end)
end

