            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then movendo = true end
            if movendo then
                BtnFloat.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end
end)

-- ==================== ABRIR/FECHAR ====================
local aberto = false

local function abrir()
    if aberto then return end
    aberto = true
    BtnFloat.Visible = false
    Main.Visible = true
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Size = UDim2.new(0, 300, 0, 220),
        Position = UDim2.new(0.5, -150, 0.5, -110)
    }):Play()
end

local function fechar()
    if not aberto then return end
    aberto = false
    local tween = TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    tween:Play()
    tween.Completed:Connect(function()
        Main.Visible = false
        BtnFloat.Visible = true
    end)
end

BtnFloat.MouseButton1Click:Connect(function()
    if not movendo then abrir() end
end)

BtnMin.MouseButton1Click:Connect(fechar)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        if aberto then fechar() else abrir() end
    end
end)

-- ==================== LOGICA PINBALL ====================
BtnSalvar.MouseButton1Click:Connect(function()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    posicaoSalva = Vector3.new(hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
    Status1.Text = "Salvo!\nX:" .. math.floor(posicaoSalva.X) .. " Z:" .. math.floor(posicaoSalva.Z)
    Status1.TextColor3 = TEMA.verde
    
    task.wait(2)
    Status1.Text = "Posição salva e pronta"
    Status1.TextColor3 = TEMA.textoFraco
end)

local function temParedeNaFrente(origem, direcao, distancia)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {player.Character}
    rayParams.IgnoreWater = true
    
    local resultado = workspace:Raycast(origem, direcao * distancia, rayParams)
    return resultado ~= nil
end

local function andarPinball()
    if andando then return end
    if not posicaoSalva then
        Status1.Text = "Salve uma posição primeiro!"
        Status1.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    andando = true
    BtnGo.BackgroundColor3 = Color3.fromRGB(200, 100, 0)
    BtnGo.Text = "PARAR"
    Status1.Text = "Auto Base ativado!"
    Status1.TextColor3 = TEMA.verde
    
    task.spawn(function()
        local ladoAtual = 1
        local tempoUltimaTroca = 0
        
        while andando do
            local char = player.Character
            if not char then break end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then break end
            
            local posAtual = hrp.Position
            local direcao = posicaoSalva - posAtual
            local distancia = direcao.Magnitude
            
            if distancia < 5 then
                hrp.CFrame = CFrame.new(posicaoSalva)
                hrp.AssemblyLinearVelocity = Vector3.zero
                break
            end
            
            local dirXZ = Vector3.new(direcao.X, 0, direcao.Z)
            if dirXZ.Magnitude < 0.01 then break end
            local dirUnit = dirXZ.Unit
            
            local lateral = Vector3.new(-dirUnit.Z, 0, dirUnit.X)
            
            local direcaoLateral = lateral * ladoAtual
            local temParede = temParedeNaFrente(posAtual, direcaoLateral, DETECCAO_PAREDE)
            
            local agora = tick()
            if temParede and (agora - tempoUltimaTroca) > TEMPO_ENTRE_TROCA then
                ladoAtual = -ladoAtual
                tempoUltimaTroca = agora
            end
            
            local velocity = Vector3.new(
                (dirUnit.X * VELOCIDADE) + (lateral.X * ladoAtual * VEL_LATERAL),
                0,
                (dirUnit.Z * VELOCIDADE) + (lateral.Z * ladoAtual * VEL_LATERAL)
            )
            
            hrp.AssemblyLinearVelocity = velocity
            
            if math.random() < 0.1 then
                local paredeStatus = temParede and " " or ""
                local ladoTexto = ladoAtual == 1 and "→" or "←"
                Status1.Text = " " .. math.floor(distancia) .. " Pasos " .. ladoTexto .. paredeStatus
            end
            
            task.wait()
        end
        
        andando = false
        BtnGo.BackgroundColor3 = TEMA.destaque
        BtnGo.Text = "GO"
        Status1.Text = "Chegou no destino!"
        Status1.TextColor3 = TEMA.verde
        
        task.wait(2)
        Status1.Text = "Posição salva e pronta"
        Status1.TextColor3 = TEMA.textoFraco
    end)
end

BtnGo.MouseButton1Click:Connect(function()
    if andando then
        andando = false
        BtnGo.BackgroundColor3 = TEMA.destaque
        BtnGo.Text = "GO"
        Status1.Text = "Parado"
        Status1.TextColor3 = TEMA.textoFraco
    else
        andarPinball()
    end
end)

