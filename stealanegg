-- Arrastar
local arrastando = false
local offset = Vector2.new()

BtnFloat.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch 
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        arrastando = true
        offset = Vector2.new(
            input.Position.X - BtnFloat.AbsolutePosition.X,
            input.Position.Y - BtnFloat.AbsolutePosition.Y
        )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if arrastando and (input.UserInputType == Enum.UserInputType.Touch 
    or input.UserInputType == Enum.UserInputType.MouseMovement) then
        BtnFloat.Position = UDim2.new(0, input.Position.X - offset.X, 0, input.Position.Y - offset.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch 
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        arrastando = false
    end
end)

-- ==================== ABRIR/FECHAR ====================
local aberto = false

local function abrir()
    if aberto then return end
    aberto = true
    BtnFloat.Visible = false
    Main.Visible = true
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
        Size = UDim2.new(0, 300, 0, 180),
        Position = UDim2.new(0.5, -150, 0.5, -90)
    }):Play()
end

local function fechar()
    if not aberto then return end
    aberto = false
    local tween = TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0)
    })
    tween:Play()
    tween.Completed:Connect(function()
        Main.Visible = false
        BtnFloat.Visible = true
    end)
end

BtnFloat.MouseButton1Click:Connect(function()
    if not arrastando then abrir() end
end)

BtnMin.MouseButton1Click:Connect(fechar)
BtnFechar.MouseButton1Click:Connect(fechar)

-- Atalho K
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.K then
        if aberto then fechar() else abrir() end
    end
end)

-- Abre automático
task.wait(1)
abrir()

